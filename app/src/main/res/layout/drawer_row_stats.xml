<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal">

    <Button
        android:id="@+id/drawerStatsButton"
        style="@style/Mpv.DrawerPillButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/toggle_stats"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/drawerStatsPage1Button"
        style="@style/Mpv.DrawerPillButton.Compact"
        android:layout_width="44dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/accessibility_stats_page_1"
        android:text="@string/stats_page_1_number"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/drawerStatsPage2Button"
        style="@style/Mpv.DrawerPillButton.Compact"
        android:layout_width="44dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/accessibility_stats_page_2"
        android:text="@string/stats_page_2_number"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/drawerStatsPage3Button"
        style="@style/Mpv.DrawerPillButton.Compact"
        android:layout_width="44dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:nextFocusRight="@id/tabBtnVideo"
        android:contentDescription="@string/accessibility_stats_page_3"
        android:text="@string/stats_page_3_number"
        android:textAllCaps="false" />
</LinearLayout>
