<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="74dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:background="@drawable/bg_player_title_style_control"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/titleStyleControlLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text_dim"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="Font" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/titleStyleControlPrevious"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_player_title_style_step"
            android:contentDescription="@string/btn_decrease"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_chevron_left_24"
            app:tint="@color/tv_text" />

        <TextView
            android:id="@+id/titleStyleControlValue"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_value"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="@color/tv_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Semibold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/titleStyleControlNext"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_player_title_style_step"
            android:contentDescription="@string/btn_increase"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_chevron_right_24"
            app:tint="@color/tv_text" />
    </LinearLayout>
</LinearLayout>
