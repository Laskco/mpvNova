        </LinearLayout>

        <ImageButton
            android:id="@+id/subPresetMinusBtn"
            style="@style/MpvPlayer.ButtonBarIconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/btn_decrease"
            android:minWidth="34dp"
            android:minHeight="34dp"
            app:srcCompat="@drawable/ic_remove_24dp"
            app:tint="@color/tv_text" />

        <TextView
            android:id="@+id/subPresetValue"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/tv_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Crunchyroll" />

        <ImageButton
            android:id="@+id/subPresetPlusBtn"
            style="@style/MpvPlayer.ButtonBarIconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/btn_increase"
            android:minWidth="34dp"
            android:minHeight="34dp"
            app:srcCompat="@drawable/ic_add_24dp"
            app:tint="@color/tv_text" />
    </LinearLayout>

