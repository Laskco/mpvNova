<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subFiltersContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/persistSubFiltersRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tv_track_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_tv_icon_chip">

            <ImageView
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_filter_alt_24dp"
                app:tint="@color/tv_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_persist_sub_filters_title"
                android:textColor="@color/tv_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/dialog_persist_sub_filters_summary"
                android:textColor="@color/tv_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/persistSubFiltersCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/accessibility_selected"
            android:src="@drawable/ic_tv_check"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onlineSubtitleActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/onlineSubtitleSearch"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:nextFocusUp="@id/persistSubFiltersRow"
            android:nextFocusRight="@id/onlineSubtitleDownloads"
            android:nextFocusDown="@id/delayRow"
            android:text="@string/opensubtitles_search_title" />

        <Button
            android:id="@+id/onlineSubtitleDownloads"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:nextFocusUp="@id/persistSubFiltersRow"
            android:nextFocusLeft="@id/onlineSubtitleSearch"
            android:nextFocusDown="@id/delayRow"
            android:text="@string/os_downloads_action"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/subStyleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tv_track_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_tv_icon_chip">

            <ImageView
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_subtitles_black_24dp"
                app:tint="@color/tv_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_style_title"
                android:textColor="@color/tv_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/sub_style_row_summary"
                android:textColor="@color/tv_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/subStyleValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="14dp"
            android:gravity="end"
            android:textColor="@color/tv_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Off" />
    </LinearLayout>

    <!-- Saved preset quick-cycle (shown only when presets exist) -->
