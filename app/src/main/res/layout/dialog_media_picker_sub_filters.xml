                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/btn_secondary_pos_summary"
                android:textColor="@color/tv_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

