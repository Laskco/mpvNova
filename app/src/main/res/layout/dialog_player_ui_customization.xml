<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_dialog_shell"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp"
    tools:ignore="ButtonStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MpvTv.TextSmallCaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drawer_section_interface"
                android:textColor="?attr/mpvAccentHot" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/player_ui_customization_title"
                android:textColor="@color/tv_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/player_ui_customization_summary"
                android:textColor="@color/tv_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/playerUiDoneBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="74dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/dialog_done"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/playerUiPresetTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:text="@string/player_ui_tab_presets"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playerUiSurfaceTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:text="@string/player_ui_tab_surface"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playerUiLayoutTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:text="@string/player_ui_tab_layout"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playerUiControlsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:text="@string/player_ui_tab_controls"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tv_panel_card"
        android:clipChildren="true"
        android:clipToOutline="true"
        tools:targetApi="s">

        <ScrollView
            android:id="@+id/playerUiScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:scrollbarDefaultDelayBeforeFade="1200"
            android:scrollbarFadeDuration="240"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/playerUiContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/playerUiPresetStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text_dim"
            android:textSize="12sp"
            tools:text="Current preset: Custom" />

        <Button
            android:id="@+id/playerUiResetBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="110dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/player_ui_reset_all"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
