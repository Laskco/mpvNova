<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_dialog_shell"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MpvTv.TextSmallCaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drawer_section_interface"
                android:textColor="?attr/mpvAccentHot" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/player_title_style_title"
                android:textColor="@color/tv_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/player_title_style_summary"
                android:textColor="@color/tv_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/titleStyleDoneBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="74dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/dialog_done"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/titleStyleSeasonTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:maxLines="1"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_season"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStyleEpisodeNumberTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:maxLines="1"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_episode_number"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStyleTitleTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:maxLines="1"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_show_title"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStyleEpisodeTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:maxLines="1"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_episode_title"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/titleStyleDateTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_date"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStyleClockTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_clock"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStyleEndsAtTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_player_title_style_tab"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_ends_at"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tv_panel_card"
        android:clipChildren="true"
        android:clipToOutline="true"
        tools:targetApi="s">

        <app.mpvnova.player.TvSmoothScrollView
            android:id="@+id/titleStyleScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:padding="10dp"
            android:scrollbarDefaultDelayBeforeFade="1200"
            android:scrollbarFadeDuration="240"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/titleStyleControlsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </app.mpvnova.player.TvSmoothScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/custom_preset_label"
            android:textColor="@color/tv_text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/titleStylePresetMinusBtn"
            style="@style/MpvPlayer.ButtonBarIconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/btn_decrease"
            app:srcCompat="@drawable/ic_remove_24dp"
            app:tint="@color/tv_text" />

        <TextView
            android:id="@+id/titleStylePresetValue"
            android:layout_width="132dp"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/tv_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Cinema" />

        <ImageButton
            android:id="@+id/titleStylePresetPlusBtn"
            style="@style/MpvPlayer.ButtonBarIconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/btn_increase"
            app:srcCompat="@drawable/ic_add_24dp"
            app:tint="@color/tv_text" />

        <Button
            android:id="@+id/titleStylePresetSaveBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="112dp"
            android:stateListAnimator="@null"
            android:text="@string/custom_preset_save"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStylePresetDeleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="82dp"
            android:stateListAnimator="@null"
            android:text="@string/custom_preset_delete"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/titleStyleVisibilityBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="154dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold"
            tools:text="Episode title: Shown" />

        <Button
            android:id="@+id/titleStyleSeparatorBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="126dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold"
            tools:text="Separator: Dot" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/titleStyleResetPartBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="138dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_reset_part"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/titleStyleResetAllBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_player_title_style_action"
            android:minWidth="106dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/player_title_style_reset_all"
            android:textAllCaps="false"
            android:textColor="@color/tv_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
