<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_dialog_shell"
    android:elevation="24dp"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">
    <TextView
        style="@style/MpvTv.TextSmallCaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/option_picker_playback"
        android:textColor="?attr/mpvAccentHot" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0"
        android:text="@string/pref_segment_skipping_title"
        android:textColor="@color/tv_text"
        android:textSize="24sp"
        android:textStyle="bold" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:scrollbars="vertical"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideInset"
        android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track">
        <LinearLayout
            android:id="@+id/segmentRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:orientation="vertical" />
    </ScrollView>
    <Button
        android:id="@+id/segmentDoneBtn"
        style="@style/Mpv.SurfaceButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:minWidth="76dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/dialog_done" />
</LinearLayout>
