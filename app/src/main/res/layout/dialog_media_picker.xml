<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_dialog_shell"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/contentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
            style="@style/MpvTv.TextSmallCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mpv_activity"
            android:textColor="?attr/mpvAccentHot" />

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="-0.01"
            android:textColor="@color/tv_text"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Audio" />

        <TextView
            android:id="@+id/pickerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="520dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/tv_text_dim"
            android:textSize="12sp"
            tools:text="Choose an audio track and shape the sound for your room." />

        <LinearLayout
            android:id="@+id/trackPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tv_panel_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            tools:ignore="NestedWeights">

            <LinearLayout
                android:id="@+id/listHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/listSectionTitle"
                    style="@style/MpvTv.TextSmallCaps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dialog_section_tracks" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="true"
                android:minHeight="250dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingStart="0dp"
                android:paddingBottom="2dp"
                android:scrollbarFadeDuration="240"
                android:scrollbarDefaultDelayBeforeFade="1200"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track"
                android:scrollbars="vertical"
                app:layoutManager="app.mpvnova.player.TvWeightedLinearLayoutManager"
                tools:ignore="NestedWeights"
                tools:listitem="@layout/dialog_track_item" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="430dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

            <app.mpvnova.player.TvSmoothScrollView
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingEnd="10dp"
                android:paddingStart="0dp"
                android:scrollbarFadeDuration="240"
                android:scrollbarDefaultDelayBeforeFade="1200"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:visibility="gone"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:id="@+id/filterGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="10dp"
                    android:paddingStart="0dp">

                    <ViewStub
                        android:id="@+id/audioFiltersStub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout="@layout/dialog_media_picker_audio_filters" />

                    <ViewStub
                        android:id="@+id/subFiltersStub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout="@layout/dialog_media_picker_sub_filters" />

                    <LinearLayout
                        android:id="@+id/delayRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tv_track_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="76dp"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_tv_icon_chip">

                            <ImageView
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_sub_delay"
                                app:tint="@color/tv_text" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/delayTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_delay_label"
                                android:textColor="@color/tv_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:id="@+id/delaySummary"
                                android:text="@string/dialog_section_timing_summary"
                                android:textColor="@color/tv_text_dim"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/delayValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="14dp"
                            android:gravity="end"
                            android:textColor="@color/tv_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="0.00 s" />
                    </LinearLayout>
                </LinearLayout>
            </app.mpvnova.player.TvSmoothScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
