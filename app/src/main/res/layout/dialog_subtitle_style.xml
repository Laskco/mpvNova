<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="ButtonStyle">
    <LinearLayout
        android:id="@+id/styleEditorPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tv_dialog_shell"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/MpvTv.TextSmallCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drawer_section_subtitles"
                    android:textColor="?attr/mpvAccentHot" />
                <TextView
                    android:id="@+id/styleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_editor_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tv_text"
                    android:maxLines="2" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/styleMaster"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="@string/sub_editor_enabled"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:switchPadding="8dp"
                android:background="@drawable/bg_player_title_style_action"
                android:padding="6dp" />
            <Button
                android:id="@+id/styleDoneBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/dialog_done"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:background="@drawable/bg_player_title_style_action"
                android:stateListAnimator="@null" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/styleTextTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_player_title_style_tab"
                android:text="@string/sub_editor_text"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/styleEdgesTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_player_title_style_tab"
                android:text="@string/sub_editor_edges"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/styleLayoutTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_player_title_style_tab"
                android:text="@string/sub_editor_layout"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/styleAdvancedTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_player_title_style_tab"
                android:text="@string/sub_editor_advanced"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:stateListAnimator="@null" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tv_panel_card">
            <app.mpvnova.player.TvSmoothScrollView
                android:id="@+id/styleScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingStart="8dp"
                android:paddingEnd="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:scrollbars="vertical"
                android:scrollbarStyle="insideInset"
                android:scrollbarSize="3dp"
                android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track">
                <LinearLayout
                    android:id="@+id/styleContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </app.mpvnova.player.TvSmoothScrollView>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/stylePresetMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_player_title_style_step"
                android:padding="9dp"
                android:contentDescription="@string/btn_decrease"
                app:srcCompat="@drawable/ic_remove_24dp"
                app:tint="@color/tv_text" />
            <Button
                android:id="@+id/stylePresetValue"
                android:layout_width="132dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:background="@drawable/bg_player_title_style_action"
                android:stateListAnimator="@null" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/stylePresetPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_player_title_style_step"
                android:padding="9dp"
                android:contentDescription="@string/btn_increase"
                app:srcCompat="@drawable/ic_add_24dp"
                app:tint="@color/tv_text" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <Button
                android:id="@+id/styleSaveBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sub_style_save_preset"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:background="@drawable/bg_player_title_style_action"
                android:stateListAnimator="@null" />
            <Button
                android:id="@+id/styleResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sub_editor_reset"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:background="@drawable/bg_player_title_style_action"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/stylePreviewPanel"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:scrollbarStyle="insideInset"
        android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
        android:background="@drawable/bg_tv_dialog_shell"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <app.mpvnova.player.SubtitleStylePreviewView
            android:id="@+id/stylePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sub_editor_preview"
            android:importantForAccessibility="yes" />
    </ScrollView>
</LinearLayout>
