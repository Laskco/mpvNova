<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_dialog_shell"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <TextView
        style="@style/MpvTv.TextSmallCaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/drawer_section_interface"
        android:textColor="?attr/mpvAccentHot" />

    <TextView
        android:id="@+id/customPresetDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="Save preset" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tv_panel_card"
        android:orientation="vertical"
        android:padding="14dp">

        <EditText
            android:id="@+id/customPresetNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_preset_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="12"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/tv_text"
            android:textColorHint="@color/tv_text_dim"
            android:textSize="16sp"
            tools:ignore="LabelFor" />

        <TextView
            android:id="@+id/customPresetNameCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:textColor="@color/tv_text_dim"
            android:textSize="11sp"
            tools:text="0/12" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/customPresetCancelBtn"
            style="@style/Mpv.SurfaceButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="76dp"
            android:text="@string/dialog_cancel" />

        <Button
            android:id="@+id/customPresetSaveBtn"
            style="@style/Mpv.SurfaceButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:minWidth="76dp"
            android:text="@string/dialog_save" />
    </LinearLayout>
</LinearLayout>
