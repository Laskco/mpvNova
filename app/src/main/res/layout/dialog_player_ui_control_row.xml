<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_player_title_style_control"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/playerUiControlLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Playback speed" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/playerUiControlVisibility"
        android:layout_width="136dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_dialog_action"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:stateListAnimator="@null"
        android:textColor="@color/tv_text"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Shown" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/playerUiControlLeft"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_player_title_style_step"
        android:contentDescription="@string/player_ui_move_up"
        android:padding="7dp"
        app:srcCompat="@drawable/ic_chevron_up_24"
        app:tint="@color/tv_text" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/playerUiControlRight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_player_title_style_step"
        android:contentDescription="@string/player_ui_move_down"
        android:padding="7dp"
        app:srcCompat="@drawable/ic_chevron_down_24"
        app:tint="@color/tv_text" />
</LinearLayout>
