<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_tv_player_button_focused" android:state_focused="true" />
    <item android:drawable="@drawable/bg_tv_player_button_focused" android:state_pressed="true" />
    <item android:drawable="@drawable/bg_tv_player_button_focused" android:state_selected="true" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/mpvChipStart" />
            <stroke android:width="1dp" android:color="?attr/mpvStroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
