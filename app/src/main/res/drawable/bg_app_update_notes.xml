<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/mpvFocusWash" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/mpvStrokeFocus" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/mpvFocusWashSoft" />
            <stroke
                android:width="1dp"
                android:color="?attr/mpvStrokeFocus" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/mpvSurfaceSoft" />
            <stroke
                android:width="1dp"
                android:color="?attr/mpvStroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
