<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".preferences.AboutActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_hero_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/mpv_activity"
                app:srcCompat="@drawable/mpv_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MpvTv.TextSmallCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_header_about_mpv" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_hero_title"
                    android:textColor="@color/tv_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_hero_subtitle"
                    android:textColor="@color/tv_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:text="@string/tmdb_attribution"
            android:textColor="@color/tv_text_dim"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="16dp"
            android:background="@drawable/bg_surface_host"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="10dp"
            android:paddingBottom="18dp">

            <app.mpvnova.player.TvSmoothScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:overScrollMode="never"
                android:scrollbarDefaultDelayBeforeFade="1200"
                android:scrollbarFadeDuration="240"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/bg_tv_scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/bg_tv_scrollbar_track"
                android:scrollbars="vertical">

                <HorizontalScrollView
                    android:id="@+id/aboutHorizontalScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_list_row"
                    android:clipToPadding="true"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="true"
                    android:overScrollMode="never"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbarDefaultDelayBeforeFade="1200"
                    android:scrollbarFadeDuration="240"
                    android:scrollbarSize="3dp"
                    android:scrollbarStyle="insideInset"
                    android:scrollbarThumbHorizontal="@drawable/bg_tv_scrollbar_thumb"
                    android:scrollbarTrackHorizontal="@drawable/bg_tv_scrollbar_track"
                    android:scrollbars="horizontal">

                    <TextView
                        android:id="@+id/logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:focusable="false"
                        android:fontFamily="sans-serif"
                        android:paddingBottom="8dp"
                        android:textColor="@color/tv_text"
                        android:textSize="13sp"
                        tools:text="mpvNova 2026-03-22-release / 45 (debug)" />

                </HorizontalScrollView>
            </app.mpvnova.player.TvSmoothScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
