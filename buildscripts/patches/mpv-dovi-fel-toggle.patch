+static int send_dovi_packet(vd_ffmpeg_ctx *ctx, AVCodecContext *avctx,
+                            struct demux_packet *pkt)
+{
+    if (!ctx->dovi_bsf) {
+        mp_set_av_packet(ctx->avpkt, pkt, &ctx->codec_timebase);
+        return avcodec_send_packet(avctx, pkt ? ctx->avpkt : NULL);
+    }
+
+    if (!pkt)
+        return avcodec_send_packet(avctx, NULL);
+
+    if (!ctx->dovi_pkt_pending) {
+        av_packet_unref(ctx->dovi_in_pkt);
+        int ret = av_packet_ref(ctx->dovi_in_pkt, pkt->avpacket);
+        if (ret < 0)
+            return ret;
+
+        ctx->dovi_in_pkt->data = pkt->buffer;
+        ctx->dovi_in_pkt->size = pkt->len;
+        ctx->dovi_in_pkt->pts = mp_pts_to_av(pkt->pts, &ctx->codec_timebase);
+        ctx->dovi_in_pkt->dts = mp_pts_to_av(pkt->dts, &ctx->codec_timebase);
+        if (ctx->codec_timebase.num > 0 && ctx->codec_timebase.den > 0)
+            ctx->dovi_in_pkt->duration = pkt->duration / av_q2d(ctx->codec_timebase);
+        if (pkt->keyframe)
+            ctx->dovi_in_pkt->flags |= AV_PKT_FLAG_KEY;
+
+        ret = av_bsf_send_packet(ctx->dovi_bsf, ctx->dovi_in_pkt);
+        if (ret < 0)
+            return ret;
+
+        ret = av_bsf_receive_packet(ctx->dovi_bsf, ctx->dovi_pkt);
+        if (ret == AVERROR(EAGAIN))
+            return 0;
+        if (ret < 0)
+            return ret;
+        ctx->dovi_pkt_pending = true;
+    }
+
+    int ret = avcodec_send_packet(avctx, ctx->dovi_pkt);
+    if (ret != AVERROR(EAGAIN)) {
+        av_packet_unref(ctx->dovi_pkt);
+        ctx->dovi_pkt_pending = false;
+    }
+    return ret;
+}
