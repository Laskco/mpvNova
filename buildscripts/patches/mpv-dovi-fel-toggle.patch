+static int init_dovi_bsf(struct mp_filter *vd, AVCodecContext *avctx)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC || ctx->opts->dovi_fel)
+        return 0;
+
+    bool has_fel = false;
+    for (int n = 0; n < avctx->nb_coded_side_data; n++) {
+        const AVPacketSideData *side_data = &avctx->coded_side_data[n];
+        if (side_data->type != AV_PKT_DATA_DOVI_CONF ||
+            side_data->size < sizeof(AVDOVIDecoderConfigurationRecord))
+            continue;
+
+        const AVDOVIDecoderConfigurationRecord *dovi = (void *)side_data->data;
+        has_fel = dovi->dv_profile == 7 && dovi->el_present_flag;
+        break;
+    }
+    if (!has_fel)
+        return 0;
+
+    const AVBitStreamFilter *filter = av_bsf_get_by_name("dovi_split");
+    if (!filter) {
+        MP_ERR(vd, "FFmpeg was built without the dovi_split filter.\n");
+        return AVERROR_BSF_NOT_FOUND;
+    }
+
+    AVBSFContext *bsf = NULL;
+    AVPacket *in_pkt = NULL;
+    AVPacket *out_pkt = NULL;
+    int ret = av_bsf_alloc(filter, &bsf);
+    if (ret < 0)
+        return ret;
+
+    ret = avcodec_parameters_from_context(bsf->par_in, avctx);
+    if (ret < 0)
+        goto fail;
+
+    bsf->time_base_in = ctx->codec_timebase;
+    ret = av_opt_set(bsf->priv_data, "mode", "bl_rpu", 0);
+    if (ret < 0)
+        goto fail;
+
+    ret = av_bsf_init(bsf);
+    if (ret < 0)
+        goto fail;
+
+    in_pkt = av_packet_alloc();
+    out_pkt = av_packet_alloc();
+    if (!in_pkt || !out_pkt) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ctx->dovi_in_pkt = in_pkt;
+    ctx->dovi_pkt = out_pkt;
+    ctx->dovi_bsf = bsf;
+    return 0;
+
+fail:
+    av_packet_free(&in_pkt);
+    av_packet_free(&out_pkt);
+    av_bsf_free(&bsf);
+    return ret;
+}
