diff --git a/sub/osd.h b/sub/osd.h
index b62836e517..83ff30db5e 100644
--- a/sub/osd.h
+++ b/sub/osd.h
@@ -93,6 +93,10 @@ struct sub_bitmaps {
 
     int change_id;  // Incremented on each change (0 is never used)
 
+    // Process-unique identity of packed pixel contents and layout, independent
+    // of part colors/positions. Zero means the producer does not track it.
+    uint64_t packed_id;
+
     bool video_color_space; // True if the bitmap is in video color space
 };
 
diff --git a/sub/packer.c b/sub/packer.c
index bebb4561f5..623c8daa98 100644
--- a/sub/packer.c
+++ b/sub/packer.c
@@ -21,6 +21,7 @@
 #include <stdarg.h>
 #include <stdbool.h>
 #include <assert.h>
+#include <stdatomic.h>
 
 #include "config.h"
 
@@ -47,6 +48,8 @@ struct mp_sub_packer {
     struct bitmap_packer *packer;
 };
 
+static atomic_ullong next_packed_id;
+
 // Free with talloc_free().
 struct mp_sub_packer *mp_sub_packer_alloc(void *ta_parent)
 {
@@ -203,6 +206,56 @@ static bool pack_libass(struct mp_sub_packer *p, struct sub_bitmaps *res)
         b->stride = stride;
     }
 
+    res->packed_id = atomic_fetch_add_explicit(&next_packed_id, 1,
+                                               memory_order_relaxed) + 1;
+    return true;
+}
+
+static bool reuse_libass(struct mp_sub_packer *p, ASS_Image **lists, int count,
+                         bool video_color_space, struct sub_bitmaps *out)
+{
+    struct sub_bitmaps *cached = &p->cached_subs;
+    if (!p->cached_subs_valid || cached->format != SUBBITMAP_LIBASS ||
+        !cached->packed || !cached->packed_id)
+        return false;
+
+    int part = 0;
+    for (int n = 0; n < count; n++) {
+        for (ASS_Image *img = lists[n]; img; img = img->next) {
+            if (!img->w || !img->h)
+                continue;
+            if (part >= cached->num_parts)
+                return false;
+            const struct sub_bitmap *b = &cached->parts[part++];
+            if (img->w != b->w || img->h != b->h)
+                return false;
+            // libass can reuse allocations for different masks. Compare owned
+            // pixels, not source pointers, and never read the last row padding.
+            for (int y = 0; y < img->h; y++) {
+                if (memcmp(img->bitmap + (ptrdiff_t)y * img->stride,
+                           (uint8_t *)b->bitmap + (ptrdiff_t)y * b->stride,
+                           img->w))
+                    return false;
+            }
+        }
+    }
+    if (part != cached->num_parts)
+        return false;
+
+    part = 0;
+    for (int n = 0; n < count; n++) {
+        for (ASS_Image *img = lists[n]; img; img = img->next) {
+            if (!img->w || !img->h)
+                continue;
+            struct sub_bitmap *b = &cached->parts[part++];
+            b->x = img->dst_x;
+            b->y = img->dst_y;
+            b->libass.color = img->color;
+        }
+    }
+    cached->video_color_space = video_color_space;
+    *out = *cached;
+    out->change_id = 1;
     return true;
 }
 
@@ -283,6 +336,10 @@ void mp_sub_packer_pack_ass(struct mp_sub_packer *p, ASS_Image **image_lists,
         return;
     }
 
+    if (format == SUBBITMAP_LIBASS &&
+        reuse_libass(p, image_lists, num_image_lists, video_color_space, out))
+        return;
+
     *out = (struct sub_bitmaps){.change_id = 1};
     p->cached_subs_valid = false;
 
