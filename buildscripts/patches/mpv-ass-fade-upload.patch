     int change_id;
+    uint64_t packed_id;
     struct ra_tex *texture;
     int w, h;
     int num_subparts;
@@ -186,11 +187,21 @@ static void gen_osd_cb(void *pctx, struct sub_bitmaps *imgs)
     struct mpgl_osd_part *osd = ctx->parts[imgs->render_index];
 
     bool ok = true;
-    if (imgs->change_id != osd->change_id) {
-        if (!upload_osd(ctx, osd, imgs))
+    bool same_pixels = imgs->packed_id
+        ? imgs->packed_id == osd->packed_id
+        : !osd->packed_id && imgs->change_id == osd->change_id;
+    if (!osd->texture || osd->format != imgs->format || !same_pixels)
+    {
+        if (!upload_osd(ctx, osd, imgs)) {
             ok = false;
-
-        osd->change_id = imgs->change_id;
+            osd->change_id = 0;
+            osd->packed_id = 0;
+        } else {
+            osd->change_id = imgs->change_id;
+            osd->packed_id = imgs->packed_id;
+            MP_TRACE(ctx, "OSD atlas uploaded: %dx%d\n", imgs->packed_w,
+                     imgs->packed_h);
+        }
     }
     osd->num_subparts = ok ? imgs->num_parts : 0;
 
