diff --git a/audio/out/ao_audiotrack.c b/audio/out/ao_audiotrack.c
--- a/audio/out/ao_audiotrack.c
+++ b/audio/out/ao_audiotrack.c
@@ -749,2 +749,9 @@
     p->chunksize = p->size;
+    if (p->format != AudioFormat.ENCODING_IEC61937) {
+        // Keep the device queue intact, but refresh the presentation clock
+        // more often than once per device buffer during blocking PCM writes.
+        int stride = bps * ao->channels.num;
+        int quantum = MPMAX(1, p->samplerate / 50);
+        p->chunksize = MPMIN(p->size / stride, quantum) * stride;
+    }
     p->chunk = talloc_size(ao, p->size);
