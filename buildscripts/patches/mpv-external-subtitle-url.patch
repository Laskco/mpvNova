+static const char *external_file_basename(void *ctx, const char *fname)
+{
+    int scheme_len = !strncasecmp(fname, "https://", 8) ? 8 :
+                     !strncasecmp(fname, "http://", 7) ? 7 : 0;
+    if (!scheme_len)
+        return mp_basename(fname);
+
+    // Decode only the matching name, never the transport URL or signed query.
+    char *url = talloc_strndup(ctx, fname, strcspn(fname, "?#"));
+    const char *path = strchr(url + scheme_len, '/');
+    if (!path)
+        return "";
+    const char *name = mp_basename(path);
+    // These escapes cannot describe a local basename safely.
+    for (const char *p = name; (p = strchr(p, '%')); p++) {
+        if (!strncasecmp(p, "%00", 3) || !strncasecmp(p, "%2f", 3) ||
+            !strncasecmp(p, "%5c", 3))
+            return name;
+    }
+    return mp_url_unescape(ctx, name);
+}
