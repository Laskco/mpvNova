+static bool set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    if (paused) {
+        int64_t now = presentation_now_ns();
+        p->pause_failed = !pause_track(ao);
+        if (p->pause_failed) {
+            ao_request_reload(ao);
+            return false;
+        }
+        mp_mutex_lock(&p->lock);
+        int64_t base = p->bridge_start ? p->bridge_start : p->presentation_time;
+        p->resume_pos_valid = base && now >= base && now - base < MP_TIME_S_TO_NS(1) &&
+                              p->written_frames - p->presentation_pos <= 2U * ao->samplerate;
+        if (p->resume_pos_valid) {
+            uint32_t advance = MP_TIME_NS_TO_S(now - base) * ao->samplerate;
+            p->presentation_pos += MPMIN(advance, p->written_frames - p->presentation_pos);
+        }
+        p->bridge_start = p->presentation_time = p->startup_wait_start = 0;
+        p->startup_wait_pending = false;
+        mp_mutex_unlock(&p->lock);
+        return true;
+    }
+    // A failed pause can leave the playing writer holding the lock until reset.
+    if (p->pause_failed)
+        return false;
+    mp_mutex_lock(&p->lock);
+    // Do not extrapolate an Android timestamp across the paused interval.
+    p->timestamp_floor = presentation_now_ns();
+    p->timestamp_fetched = 0;
+    p->timestamp_set = false;
+    p->bridge_start = p->resume_pos_valid ? p->timestamp_floor : 0;
+    p->resume_pos_valid = false;
+    start(ao);
+    mp_mutex_unlock(&p->lock);
+    return true;
+}
