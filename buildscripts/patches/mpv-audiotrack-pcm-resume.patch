+static void stop(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!pause_track(ao)) {
+        ao_request_reload(ao);
+        return;
+    }
+
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    // Pause first to interrupt any blocking write held by the audio thread.
+    mp_mutex_lock(&p->lock);
     MP_JNI_CALL_VOID(p->audiotrack, AudioTrack.flush);
     MP_JNI_EXCEPTION_LOG(ao);
 
+    p->pending_bytes = 0;
     p->playhead_offset = 0;
     p->reset_pending = true;
     p->written_frames = 0;
+    p->presentation_time = p->bridge_start = p->startup_wait_start = 0;
+    p->resume_pos_valid = false;
+    p->startup_wait_pending = (p->format != AudioFormat.ENCODING_IEC61937);
+    p->timestamp_floor = presentation_now_ns();
     p->timestamp_fetched = 0;
     p->timestamp_set = false;
+    mp_mutex_unlock(&p->lock);
 }
 
