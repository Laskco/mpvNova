diff --git a/stream/stream_curl.c b/stream/stream_curl.c
index ceb843bc4d..b115b7cbac 100644
--- a/stream/stream_curl.c
+++ b/stream/stream_curl.c
@@ -964,10 +964,13 @@ static int curl_open(stream_t *s, const struct stream_open_args *args)
     p->s = s;
     p->opts = talloc_steal(p, opts);
     p->net_opts = mp_get_config_group(p, s->global, &mp_network_conf);
-    p->url = talloc_strdup(p, s->url);
-    p->scheme = curl_scheme_lookup(bstr0(p->url));
+    p->scheme = curl_scheme_lookup(bstr0(s->url));
     // Only supported URLs are supposed to reach here.
     mp_assert(p->scheme);
+    // Match stream_lavf's HTTP escaping without changing the subtitle filename.
+    p->url = p->scheme->proto == MP_CURL_PROTO_HTTP
+        ? mp_url_escape(p, s->url, ":/?#[]@!$&'()*+,;=%")
+        : talloc_strdup(p, s->url);
     p->content_size = -1;
     p->buffer_size = p->opts->buffer_size;
     p->buffer = talloc_size(p, p->buffer_size);
